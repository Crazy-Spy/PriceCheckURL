# URL do Discord Webhook para receber alertas de ofertas e preço-alvo atingido
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_WEBHOOK_ID/SEU_WEBHOOK_TOKEN

# Menção no Discord para disparar aviso sonoro/push:
# Pode ser @here, @everyone, seu ID numérico (ex: 123456789012345678) ou @seu_usuario
DISCORD_MENTION=@crazyspy1
