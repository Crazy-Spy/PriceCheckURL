{
  "version": "2.0.0",
  "extractors": [
    {
      "id": "kabum_com_br",
      "name": "Kabum",
      "domains": [
        "kabum.com.br"
      ],
      "driver": "browser",
      "source": "wizard",
      "updatedAt": "2026-10-07 20:30:00",
      "rules": {
        "title": {
          "selector": "h1",
          "fallback": "meta[property='og:title']"
        },
        "price": {
          "selector": "number-flow-react.text-2xl",
          "regex": "R\\$\\s*([\\d\\.,]+)"
        },
        "inStock": {
          "outOfStockKeywords": [
            "ESGOTADO",
            "INDISPONÍVEL",
            "OUT OF STOCK",
            "AVISE-ME",
            "SEM ESTOQUE"
          ],
          "inStockSelector": "#purchase span"
        },
        "originalPrice": {
          "selector": "div.col-start-1 div div div div div span",
          "regex": "R\\$\\s*([\\d\\.,]+)"
        },
        "image": {
          "selector": "div.contents div div div div div div button img",
          "attribute": "src"
        }
      }
    },
